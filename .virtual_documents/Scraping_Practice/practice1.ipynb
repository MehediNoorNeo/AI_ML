import requests
from bs4 import BeautifulSoup
import pandas as pd


# fetch data and store
page_count = 1
while True:
    URL = f"https://quotes.toscrape.com/page/{page_count}/"
    res = requests.get(URL)
    
    soup = BeautifulSoup(res.text, "lxml")
    quote = soup.select("div.quote")
    if not quote:
        print(f"No vaild page anymore..")
        break
    with open(f"scraped_data/data{page_count}.html", "w", encoding="utf-8") as f:
        f.write(res.text)
    print(f"Downloaded data from page{page_count}")
    page_count = page_count+1


# data parsing
page_count = 1
life_quote = []
while(page_count <= 10):
    with open(f"scraped_data/data{page_count}.html", "r", encoding="utf-8") as f:
        page_info = f.read()
    soup = BeautifulSoup(page_info, "lxml")
    all_quote = soup.select("div.quote")
    
    for quote in all_quote:
        all_tags = quote.select("div.tags a.tag")
        for tag in all_tags:
            if "life" in tag.get_text():
                name = quote.select_one("small.author").get_text()
                text = quote.select_one("span.text").get_text()
                life_quote.append([name, text])
    page_count = page_count + 1



df = pd.DataFrame(life_quote, columns =["Author", "Quote"])
df



