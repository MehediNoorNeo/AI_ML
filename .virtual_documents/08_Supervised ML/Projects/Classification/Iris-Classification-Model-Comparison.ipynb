import pandas as pd
import seaborn as sns
from sklearn.metrics import precision_score, accuracy_score, recall_score, f1_score
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.naive_bayes import GaussianNB
from sklearn.neighbors import KNeighborsClassifier
from sklearn.model_selection import GridSearchCV
from sklearn.pipeline import Pipeline


df = pd.read_csv("Iris.csv")
df.head()


df.info()


df.nunique()


df.isnull().sum()


X = df.drop("Species", axis = 1)
y = df["Species"]


# Train Test Split
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.5, random_state=42)


# create pipeline
pipelineLR = Pipeline([
    ("scaler", StandardScaler()),
    ("lr", LogisticRegression())
])

naiveGB = GaussianNB()

pipelineKNN = Pipeline([
    ("scaler", StandardScaler()),
    ("knn", KNeighborsClassifier())
])


# data fitting
pipelineLR.fit(X_train, y_train)

naiveGB.fit(X_train, y_train)

param_grid = {
    "knn__n_neighbors" : [3, 5, 7, 9]
}

grid = GridSearchCV(
    pipelineKNN,
    param_grid,
    cv = 5,
    scoring = "accuracy"
)
grid.fit(X_train, y_train)


# Evaluation

# logistic regreser evaluation
y_pred = naiveGB.predict(X)
print("Naive Bayes Evaluation\n")
print("Accuracy: ", accuracy_score(y, y_pred))
print("Pricision: ", precision_score(y, y_pred))
print("Recall: ", recall_score(y, y_pred))

# naive bayes evaluation
y_pred = pipelineLR.predict(X)
print("Logistic Regression Evaluation\n")
print("Accuracy: ", accuracy_score(y, y_pred))
print("Pricision: ", precision_score(y, y_pred))
print("Recall: ", recall_score(y, y_pred))

# knn classifier evaluation
y_pred = grid.predict(X)
print("KNN Classifier Evaluation\n")
print("Accuracy: ", accuracy_score(y, y_pred))
print("Pricision: ", precision_score(y, y_pred))
print("Recall: ", recall_score(y, y_pred))
